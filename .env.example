# Database connection string (required)
# Get this from your Railway PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@host:port/database

# Node environment
NODE_ENV=development

# Server port (optional, defaults to 3000)
PORT=3000

# JWT Secret for admin authentication (required in production, no default)
JWT_SECRET=your-super-secret-jwt-key-change-this

# First admin. If unset, the server will not create a default admin account.
ADMIN_EMAIL=admin@sloboda.land
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_NAME=Super Admin

# Admin API key (legacy, kept for backwards compatibility — do not rely on this)
ADMIN_KEY=your-secret-admin-key

# Resend API key for email sending (optional)
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender address (optional, defaults to noreply@sloboda.land)
EMAIL_FROM=SLOBODA <noreply@sloboda.land>
